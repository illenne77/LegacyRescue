<Project>
  <!--
    Legacy (Before) build settings. Intentionally does not import modern/ settings:
    the sample must compile the way a typical 2010s WinForms project did (C# 7.3, no nullable, warnings tolerated).
  -->
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
</Project>
